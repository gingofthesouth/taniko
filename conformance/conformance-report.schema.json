{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:taniko:schema:conformance-report:0.1.0",
  "title": "Conformance Report",
  "description": "Output of the conformance suite's --json mode. Tooling-owned: versioned with the suite, not with the layer schema set.",
  "type": "object",
  "required": ["schema_version", "target", "generated_at", "tiers_run", "summary", "checks"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "target": { "type": "string" },
    "generated_at": { "type": "string", "format": "date-time" },
    "tiers_run": { "type": "array", "items": { "enum": ["static", "behavioral", "destructive"] }, "minItems": 1 },
    "summary": {
      "type": "object",
      "required": ["pass", "fail", "warn", "skip"],
      "additionalProperties": false,
      "properties": {
        "pass": { "type": "integer", "minimum": 0 },
        "fail": { "type": "integer", "minimum": 0 },
        "warn": { "type": "integer", "minimum": 0 },
        "skip": { "type": "integer", "minimum": 0 }
      }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "layer", "tier", "contract_ref", "status", "detail"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "layer": { "enum": ["harness", "loop", "state", "instruction"] },
          "tier": { "enum": ["static", "behavioral", "destructive"] },
          "contract_ref": { "type": "string", "maxLength": 200 },
          "status": { "enum": ["pass", "fail", "warn", "skip"] },
          "detail": { "type": "string", "maxLength": 500 },
          "duration_ms": { "type": "integer", "minimum": 0 }
        }
      }
    }
  }
}
